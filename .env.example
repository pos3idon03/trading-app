# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=trading_db
DATABASE_URL=postgresql+asyncpg://trading_user:changeme_strong_password@db:5432/trading_db
DATABASE_SYNC_URL=postgresql://trading_user:changeme_strong_password@db:5432/trading_db

# ── Backend ───────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ── Market Data APIs ──────────────────────────────────────────────────────────
POLYGON_API_KEY=your_polygon_api_key_here
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
FMP_API_KEY=your_fmp_api_key_here
TIINGO_API_KEY=your_tiingo_api_key_here

# ── Tiingo Ingestion Services ─────────────────────────────────────────────────
TIINGO_POSTGRES_USER=tiingo_user
TIINGO_POSTGRES_PASSWORD=changeme_tiingo_password
TIINGO_POSTGRES_DB=tiingo_db
TIINGO_DATABASE_URL=postgresql+asyncpg://tiingo_user:changeme_tiingo_password@tiingo_db:5432/tiingo_db
TIINGO_DATABASE_SYNC_URL=postgresql://tiingo_user:changeme_tiingo_password@tiingo_db:5432/tiingo_db
TIINGO_FUNDAMENTALS_TIER=dow30
ENABLE_TIINGO_SCHEDULER=true
STREAM_ENABLED=false
TIINGO_BACKEND_PORT=8002
# Tiingo frontend uses /api/v1 via Vite proxy (host: http://localhost:8002, Docker: tiingo_backend:8001)
VITE_PROXY_TARGET=http://localhost:8002
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Live Trading & Execution (Phase 5-6) ─────────────────────────────────────
ALPACA_DATA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_CRYPTO_DATA_WS_URL=wss://stream.data.alpaca.markets/v1beta3/crypto/us
TRADING_MODE=paper
MAX_POSITION_PCT=5.0
MAX_EXPOSURE_PCT=80.0
DAILY_LOSS_LIMIT_PCT=5.0
MAX_ORDERS_PER_MINUTE=10

# ── AI Agents (Phase 4) ───────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
NEWSAPI_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_api_key_here

# ── Gemini Fallback (Google AI Studio) ───────────────────────────────────────
# API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
LLM_FALLBACK_ENABLED=true
LLM_REQUEST_TIMEOUT=120
