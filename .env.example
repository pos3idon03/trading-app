# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=trading_db
DATABASE_URL=postgresql+asyncpg://trading_user:changeme_strong_password@db:5432/trading_db
DATABASE_SYNC_URL=postgresql://trading_user:changeme_strong_password@db:5432/trading_db

# ── Backend ───────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ── Market Data APIs ──────────────────────────────────────────────────────────
POLYGON_API_KEY=your_polygon_api_key_here
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Live trading API host (used when TRADING_MODE_PAPER=false)
ALPACA_BASE_URL=https://api.alpaca.markets
# Paper trading API host (used when TRADING_MODE_PAPER=true; /v2 suffix is optional)
ALPACA_BASE_PAPER_URL=https://paper-api.alpaca.markets
# Alpaca Market Data REST host (crypto/stock bars; separate from trading API)
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Crypto intraday OHLCV for live deployments: alpaca | tiingo
CRYPTO_INTRADAY_SOURCE=alpaca
FMP_API_KEY=your_fmp_api_key_here
TIINGO_API_KEY=your_tiingo_api_key_here

# ── Tiingo Ingestion Services ─────────────────────────────────────────────────
TIINGO_POSTGRES_USER=tiingo_user
TIINGO_POSTGRES_PASSWORD=changeme_tiingo_password
TIINGO_POSTGRES_DB=tiingo_db
TIINGO_DATABASE_URL=postgresql+asyncpg://tiingo_user:changeme_tiingo_password@tiingo_db:5432/tiingo_db
TIINGO_DATABASE_SYNC_URL=postgresql://tiingo_user:changeme_tiingo_password@tiingo_db:5432/tiingo_db
TIINGO_FUNDAMENTALS_TIER=dow30
YFINANCE_FUNDAMENTALS_ENABLED=true
ENABLE_TIINGO_SCHEDULER=true
STREAM_ENABLED=false
TIINGO_BACKEND_PORT=8002
REDIS_URL=redis://redis:6379
ARQ_MAX_JOBS=4
# Heavy queue: foundation_*, ml_*, news_sentiment (FinBERT)
ARQ_HEAVY_QUEUE_NAME=heavy
ARQ_HEAVY_MAX_JOBS=1
DEPLOYMENT_RECONCILIATION_INTERVAL_MINUTES=10
# IEX intraday backfill window (days) for 1m–1h; 4h bars are derived from 1h
IEX_BACKFILL_DAYS=120
# Tiingo frontend uses /api/v1 via Vite proxy (host: http://localhost:8002, Docker: tiingo_backend:8001)
VITE_PROXY_TARGET=http://localhost:8002
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Live Trading & Execution (Phase 5-6) ─────────────────────────────────────
ALPACA_DATA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_CRYPTO_DATA_WS_URL=wss://stream.data.alpaca.markets/v1beta3/crypto/us
TRADING_MODE_PAPER=true
MAX_POSITION_PCT=5.0
MAX_EXPOSURE_PCT=80.0
DAILY_LOSS_LIMIT_PCT=5.0
MAX_ORDERS_PER_MINUTE=10
DEPLOYMENT_MAX_DRAWDOWN_PCT=15.0
STALE_DATA_MAX_MISSED_SLOTS=2
STALE_DATA_BLOCK_ORDERS=true

# ── News Sentiment (FinBERT) ─────────────────────────────────────────────────
SENTIMENT_ENABLED=false
SENTIMENT_MODEL_NAME=ProsusAI/finbert
SENTIMENT_MODEL_VERSION=1
SENTIMENT_DEVICE=cpu
SENTIMENT_BATCH_SIZE=16
SENTIMENT_MAX_TEXT_CHARS=512
SENTIMENT_INTERVAL_MINUTES=30
SENTIMENT_LLM_ENABLED=false
SENTIMENT_LLM_MODEL=gemini-2.5-flash
SENTIMENT_LLM_MODEL_VERSION=1
SENTIMENT_LLM_NEUTRAL_ONLY=true
SENTIMENT_LLM_BATCH_SIZE=5
SENTIMENT_LLM_TIMEOUT=60
NEWS_TITLE_DEDUP_HOURS=6
MARKET_SENTIMENT_WINDOW_HOURS=24

# ── AI Agents (Phase 4) ───────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
NEWSAPI_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_api_key_here

# ── Gemini Fallback (Google AI Studio) ───────────────────────────────────────
# API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
LLM_FALLBACK_ENABLED=true
LLM_REQUEST_TIMEOUT=120

# ── Macro Overview GenAI Brief ────────────────────────────────────────────────
# Minimum hours between scheduled macro_seed_catalog runs (default 24 = once per day)
MACRO_SEED_INTERVAL_HOURS=24
MACRO_BRIEF_ENABLED=true
MACRO_BRIEF_MODEL=gemini-2.5-flash
MACRO_BRIEF_TIMEOUT=60

# ── Optional backend Python stacks (Docker rebuild) ─────────────────────────
# requirements-deep-learning.txt (LSTM + RL) is always baked into backend images.
# Set INSTALL_FOUNDATION=false before rebuild to skip TimesFM/Chronos deps (~large).
INSTALL_FOUNDATION=true
# Docker PyTorch wheel: cpu (default), cu128 (RTX 50 / sm_120), cu128-nightly, cu124, cu126
DOCKER_TORCH_CUDA=cpu
# GPU in containers: use docker-compose.gpu.yml (see docs/GPU_DOCKER.md).

# ── Foundation Models (TimesFM + Chronos backtesting) ───────────────────────
FOUNDATION_MODELS_ENABLED=false
# cpu or cuda (cuda requires DOCKER_TORCH_CUDA=cu128 + docker-compose.gpu.yml on RTX 50-series)
FOUNDATION_DEVICE=cpu
# FOUNDATION_MODEL_CACHE_DIR=/path/to/hf/cache
